SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily stale temp/cache cleanup at 03:17.
17 3 * * * root flock -n /run/lock/loseucaliptos-maintenance.lock /opt/loseucaliptos/scripts/maintenance-cleanup.sh >> /var/log/loseucaliptos-maintenance.log 2>&1

# Weekly snapshot on Sunday at 04:23. The latest snapshot replaces the prior one.
23 4 * * 0 root flock -n /run/lock/loseucaliptos-backup.lock /opt/loseucaliptos/scripts/backup.sh >> /var/log/loseucaliptos-backup.log 2>&1
